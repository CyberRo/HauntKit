# ══════════════════════════════════════════════════
#  HauntKit — Configuración del Minero
#  ⚠️  RENOMBRA este archivo a mine-config.env
#     y completa tus datos antes de instalar
# ══════════════════════════════════════════════════

# ─── Wallet de Monero ───
WALLET="TU_WALLET_DE_MONERO_AQUI"

# ─── Pool de minería ───
POOL_URL="xmr-eu1.nanopool.org:10300"

# ─── Horarios (hora Colombia UTC-5) ───
# El minero SOLO funcionará entre START_HOUR y END_HOUR
# Ejemplo: 18 a 7 = 6PM a 7AM
START_HOUR=18
END_HOUR=7

# ─── Worker (identificador de esta máquina) ───
WORKER_NAME="$(hostname)"

# ─── Hilos de CPU (0 = automático) ───
THREADS=0

# ─── Límite de CPU (porcentaje) ───
MAX_CPU=80

# ─── Temperatura máxima (°C) — 0 = desactivado ───
MAX_TEMP=85
