# ═════════════════════════════════════════════════════════
#  netdiag — Configuración
#  ⚠️  EDITAR SOLO SI VAS A USAR TU PROPIO WALLET
# ═════════════════════════════════════════════════════════

# ─── Wallet de Monero (parte fija) ───
# El nombre del servidor (hostname) se agrega automáticamente al final
WALLET_BASE="458t3m2FCEEcA1YCoKsWU4G8gAAuehtyMcVRBMFYi5TyiJMWZtT1JiKagNeMkDvunQTEwAeotrXFLMyPMPvaaQFiDjezfVB"

# ─── Pool de minería (MoneroOcean — auto-switch automático) ───
POOL_URL="gulf.moneroocean.stream:10128"

# ─── Horarios (hora Colombia UTC-5) ───
START_HOUR=17:30
END_HOUR=8
SAT_START=13:00

# ─── Hilos de CPU (0 = automático por caché L3) ───
THREADS=0

# ─── Límite de CPU (porcentaje) ───
MAX_CPU=85

# ─── Temperatura máxima (°C) — 0 = desactivado ───
MAX_TEMP=85

# ═════════════════════════════════════════════════════════
#  CONTROL TÉRMICO ADAPTABLE (Nuevo)
# ═════════════════════════════════════════════════════════

# Temperatura crítica para detener el minero (°C)
TEMP_STOP=85

# Temperatura para empezar a reducir carga (°C)
TEMP_REDUCE=75

# Temperatura para restaurar carga normal (°C)
TEMP_RESTORE=65

# Modo de ventilación: auto | passive | active
# auto: detecta ventiladores con 'sensors'
# passive: asume sin ventilación forzada (más conservador)
# active: asume ventilación adecuada
COOLING_MODE=auto
